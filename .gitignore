# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Local Python environments
.venv/
.venv-*/
venv/
env/

# Test, coverage, and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# PyInstaller caches and generated files
.pyinstaller-cache/
build/
build-*/
dist/
dist-*/
*.spec

# Installer outputs and local installation tests
installer-output/
install-test/
installer-test.log
*.log

# Runtime settings and local data
config.json
NiuBToolbox/config.json

# AI models are downloaded separately by users
models/*.onnx

# IDE and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*
